// Collections, products, variants, pricing, discounts — all catalog domain

model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?  @db.Text
  imageUrl    String?  @map("image_url")
  parentId    String?  @map("parent_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  metaTitle   String?  @map("meta_title")
  metaDesc    String?  @map("meta_description") @db.Text
  extraInfo   Json?    @map("extra_info")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Collection?  @relation("CollectionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Collection[] @relation("CollectionHierarchy")

  productCollections      ProductCollection[]
  discountCodeCollections DiscountCodeCollection[]

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@map("collections")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String?
  skuCode     String? @unique @map("sku_code")
  description String? @db.Text

  widthId             String? @map("width_id") @db.Uuid
  fabricCompositionId String? @map("fabric_composition_id") @db.Uuid

  weightValue Decimal?    @map("weight_value") @db.Decimal(10, 3)
  weightUnit  WeightUnit? @map("weight_unit")

  isOnOffer       Boolean    @default(false) @map("is_on_offer")
  offerType       OfferType? @map("offer_type")
  offerPercent    Decimal?   @map("offer_percent") @db.Decimal(5, 2)
  offerFixedPrice Decimal?   @map("offer_fixed_price") @db.Decimal(12, 2)

  leadTimeDays     Int?      @map("lead_time_days")
  leadTimeDate     DateTime? @map("lead_time_date") @db.Date
  availabilityDate DateTime? @map("availability_date") @db.Date

  stockStatus StockStatus @default(IN_STOCK) @map("stock_status")
  viewCount   Int         @default(0) @map("view_count")

  status    ProductStatus @default(DRAFT)
  metaTitle String?       @map("meta_title")
  metaDesc  String?       @map("meta_description") @db.Text
  extraInfo Json?         @map("extra_info")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  width             Width?             @relation(fields: [widthId], references: [id], onDelete: SetNull)
  fabricComposition FabricComposition? @relation(fields: [fabricCompositionId], references: [id], onDelete: SetNull)

  productColours          ProductColour[]
  productImages           ProductImage[]
  productAvailableLengths ProductAvailableLength[]
  productRateTiers        ProductRateTier[]
  productCareInstructions ProductCareInstruction[]
  productCollections      ProductCollection[]
  productTags             ProductTag[]
  quoteLineItems          QuoteLineItem[]
  discountCodeProducts    DiscountCodeProduct[]

  @@index([status, stockStatus])
  @@index([isOnOffer])
  @@index([viewCount])
  @@index([fabricCompositionId])
  @@map("products")
}

model ProductColour {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  colourId  String  @map("colour_id") @db.Uuid
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colour  Colour  @relation(fields: [colourId], references: [id], onDelete: Restrict)

  @@unique([productId, colourId])
  @@index([productId, sortOrder])
  @@map("product_colours")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  colourId  String? @map("colour_id") @db.Uuid
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  extraInfo Json?   @map("extra_info")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colour  Colour? @relation(fields: [colourId], references: [id], onDelete: SetNull)

  @@index([productId, colourId, sortOrder])
  @@map("product_images")
}

model ProductAvailableLength {
  id             String      @id @default(uuid()) @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  lengthPresetId String?     @map("length_preset_id") @db.Uuid
  customValue    Decimal?    @map("custom_value") @db.Decimal(10, 2)
  customUnit     LengthUnit? @map("custom_unit")
  isActive       Boolean     @default(true) @map("is_active")
  sortOrder      Int         @default(0) @map("sort_order")

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  lengthPreset LengthPreset? @relation(fields: [lengthPresetId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_available_lengths")
}

model ProductRateTier {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  minQuantity Decimal  @map("min_quantity") @db.Decimal(10, 2)
  maxQuantity Decimal? @map("max_quantity") @db.Decimal(10, 2)

  originalRate   Decimal  @map("original_rate") @db.Decimal(12, 2)
  discountedRate Decimal? @map("discounted_rate") @db.Decimal(12, 2)
  shippingCharge Decimal? @map("shipping_charge") @db.Decimal(12, 2)

  sortOrder Int @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_rate_tiers")
}

model ProductCareInstruction {
  id                String @id @default(uuid()) @db.Uuid
  productId         String @map("product_id") @db.Uuid
  careInstructionId String @map("care_instruction_id") @db.Uuid
  sortOrder         Int    @default(0) @map("sort_order")

  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  careInstruction CareInstruction @relation(fields: [careInstructionId], references: [id], onDelete: Restrict)

  @@unique([productId, careInstructionId])
  @@map("product_care_instructions")
}

model ProductCollection {
  id           String @id @default(uuid()) @db.Uuid
  productId    String @map("product_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@index([collectionId, sortOrder])
  @@map("product_collections")
}

model ProductTag {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@map("product_tags")
}

model DiscountCode {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique
  description String?
  type        DiscountType?
  scope       DiscountScope? @default(ENTIRE_ORDER)
  value       Decimal?       @db.Decimal(12, 2)

  minOrderAmount Decimal? @map("min_order_amount") @db.Decimal(14, 2)
  maxDiscount    Decimal? @map("max_discount") @db.Decimal(14, 2)

  maxUses   Int? @map("max_uses")
  usedCount Int  @default(0) @map("used_count")

  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isActive  Boolean   @default(true) @map("is_active")
  extraInfo Json?     @map("extra_info")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotes                  Quote[]
  discountCodeProducts    DiscountCodeProduct[]
  discountCodeCollections DiscountCodeCollection[]

  @@index([isActive, validFrom, validTo])
  @@map("discount_codes")
}

model DiscountCodeProduct {
  id             String @id @default(uuid()) @db.Uuid
  discountCodeId String @map("discount_code_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, productId])
  @@map("discount_code_products")
}

model DiscountCodeCollection {
  id             String @id @default(uuid()) @db.Uuid
  discountCodeId String @map("discount_code_id") @db.Uuid
  collectionId   String @map("collection_id") @db.Uuid

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, collectionId])
  @@map("discount_code_collections")
}
